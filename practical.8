```html
<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <div class="max-w-md mx-auto mt-10 bg-white p-6 rounded shadow">

        <h2 class="text-2xl font-bold mb-5 text-center text-blue-600">
            Student Registration Form
        </h2>

        <form id="registrationForm">

            <!-- Name -->
            <label class="font-semibold">Student Name</label>
            <input type="text" id="name"
                placeholder="Enter your name"
                class="w-full border p-2 mb-3 rounded">

            <!-- Email -->
            <label class="font-semibold">Email</label>
            <input type="text" id="email"
                placeholder="Enter your email"
                class="w-full border p-2 mb-3 rounded">

            <!-- Password -->
            <label class="font-semibold">Password</label>
            <input type="password" id="password"
                placeholder="Enter password"
                class="w-full border p-2 mb-2 rounded">

            <!-- Show Password -->
            <div class="mb-3">
                <input type="checkbox" id="showPassword"
                    onclick="showPass()">
                <label for="showPassword">Show Password</label>
            </div>

            <!-- Mobile -->
            <label class="font-semibold">Mobile Number</label>
            <input type="text" id="mobile"
                placeholder="Enter 10-digit mobile number"
                class="w-full border p-2 mb-4 rounded">

            <!-- Register Button -->
            <button type="submit"
                class="w-full bg-purple-500 hover:bg-purple-600 text-white p-2 rounded">
                Register Now
            </button>

            <p id="message" class="mt-4 text-center"></p>

        </form>
    </div>

    <script>

        // Show / Hide Password
        function showPass() {

            let password = document.getElementById("password");

            if (password.type === "password") {
                password.type = "text";
            } else {
                password.type = "password";
            }

        }


        document.getElementById("registrationForm").onsubmit = function(event) {

            event.preventDefault();

            let name = document.getElementById("name").value;
            let email = document.getElementById("email").value;
            let password = document.getElementById("password").value;
            let mobile = document.getElementById("mobile").value;

            let message = document.getElementById("message");

            // Check empty fields
            if (name == "" || email == "" || password == "" || mobile == "") {
                message.innerHTML = "Please fill all fields.";
                message.className = "mt-4 text-center text-red-500";
                return;
            }

            // Email validation
            if (!email.includes("@") || !email.includes(".")) {
                message.innerHTML = "Please enter a valid email.";
                message.className = "mt-4 text-center text-red-500";
                return;
            }

            // Password validation
            if (password.length < 6) {
                message.innerHTML = "Password must contain at least 6 characters.";
                message.className = "mt-4 text-center text-red-500";
                return;
            }

            // Mobile validation
            if (mobile.length != 10 || isNaN(mobile)) {
                message.innerHTML = "Please enter a valid 10-digit mobile number.";
                message.className = "mt-4 text-center text-red-500";
                return;
            }

            // Success message
            message.innerHTML = "Registration Successful!";
            message.className = "mt-4 text-center text-green-500";

        };

    </script>

</body>
</html>
```
